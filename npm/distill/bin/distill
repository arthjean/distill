#!/bin/sh
set -eu

source_path=$0
while [ -h "$source_path" ]; do
  link_dir=$(CDPATH= cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)
  link_target=$(readlink "$source_path")
  case "$link_target" in
    /*) source_path=$link_target ;;
    *) source_path=$link_dir/$link_target ;;
  esac
done
script_dir=$(CDPATH= cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)

case "$(uname -s):$(uname -m)" in
  Linux:x86_64)
    if ! command -v getconf >/dev/null 2>&1 ||
      ! getconf GNU_LIBC_VERSION >/dev/null 2>&1; then
      printf '%s\n' \
        "distill: unsupported Linux x86_64 runtime (GNU libc required)" >&2
      exit 2
    fi
    binary="$script_dir/../vendor/linux-x86_64/distill"
    ;;
  Darwin:arm64)
    binary="$script_dir/../vendor/macos-arm64/distill"
    ;;
  *)
    printf '%s\n' \
      "distill: unsupported platform $(uname -s) $(uname -m)" \
      "supported platforms: Linux x86_64, macOS arm64" >&2
    exit 2
    ;;
esac

if [ ! -x "$binary" ]; then
  printf 'distill: packaged binary is missing or not executable: %s\n' "$binary" >&2
  exit 1
fi

exec "$binary" "$@"

{
  // The retained eslint-config and typescript-config workspaces are historical
  // shared presets and remain outside the native product gate.
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": ["packages/eslint-config", "packages/typescript-config"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true,
  },
  // These exports are the retained API consumed by archived qualification
  // protocols, which stay outside the native product graph below.
  "ignoreIssues": {
    "evaluation/corpus/lib.mjs": ["exports"],
  },
  "workspaces": {
    ".": {
      "entry": ["evaluation/corpus/check.mjs"],
      "project": ["evaluation/**/*.mjs"],
      "ignore": ["evaluation/legacy/run.mjs", "evaluation/release/**"],
    },
  },
}

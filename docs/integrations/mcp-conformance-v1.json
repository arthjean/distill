{
  "schema_version": "distill.mcp-conformance/v1",
  "surface_schema_version": "distill.mcp/v1",
  "request_contract_version": "distill.context/v3",
  "protocol_version": "2025-06-18",
  "tools": [
    "distill_read",
    "distill_run",
    "distill_artifact_slice",
    "distill_artifact_search"
  ],
  "retrieval": {
    "owner": "Engine::handle",
    "pattern_language": "literal",
    "budget_required": true,
    "argument_decode_failure": "isError",
    "unbounded_recovery_is_published": false,
    "tools": [
      {
        "name": "distill_artifact_slice",
        "required": ["artifact_id", "start_line", "line_count", "budget"]
      },
      {
        "name": "distill_artifact_search",
        "required": ["artifact_id", "pattern", "budget"]
      }
    ],
    "selector_bounds": {
      "artifact_id_length": 32,
      "max_pattern_bytes": 512,
      "max_context_lines": 16,
      "max_matches": 32,
      "default_context_lines": 2,
      "default_matches": 8,
      "min_start_line": 1,
      "min_line_count": 1,
      "out_of_bounds_failure": "invalid_request"
    }
  },
  "focus": {
    "owner": "Engine::handle",
    "optional": true,
    "max_bytes": 256,
    "content_class": "literal UTF-8 text",
    "out_of_bounds_failure": "invalid_request",
    "published_by_tools": [
      "distill_read",
      "distill_run",
      "distill_artifact_slice",
      "distill_artifact_search"
    ],
    "receipt_field": "preservation.focus_applied",
    "receipt_echoes_value": false
  },
  "preservation": {
    "owner": "Engine::handle",
    "default_profile": "auto/v1",
    "derivation": "shape-detected from a bounded prefix of the observation",
    "policy_version": "distill.preservation/v2",
    "receipt_schema_version": "distill.receipt/v2",
    "receipt_fields": [
      "preservation.profile",
      "preservation.applied_profile",
      "preservation.aggregates",
      "preservation.focus_applied"
    ],
    "shape_profiles": [
      "build-output/v1",
      "test-output/v1",
      "typecheck-lint/v1",
      "stack-trace/v1",
      "unified-diff/v1",
      "api-json/v1",
      "source-file/v1",
      "terminal-log/v1"
    ],
    "retired_profiles": {
      "plain-text/v1": "terminal-log/v1",
      "build-log/v1": "build-output/v1",
      "test-log/v1": "test-output/v1",
      "diagnostic/v1": "typecheck-lint/v1",
      "diff/v1": "unified-diff/v1",
      "json/v1": "api-json/v1",
      "source-code/v1": "source-file/v1",
      "unicode/v1": "terminal-log/v1",
      "binary/v1": "terminal-log/v1",
      "untrusted-text/v1": "terminal-log/v1",
      "none/v1": "terminal-log/v1"
    },
    "unsupported_profile_failure": "invalid_request",
    "aggregation": {
      "annotated_shapes": [
        "build-output/v1",
        "test-output/v1",
        "typecheck-lint/v1",
        "stack-trace/v1",
        "terminal-log/v1"
      ],
      "verbatim_shapes": [
        "unified-diff/v1",
        "api-json/v1",
        "source-file/v1"
      ],
      "selected_retrieval_aggregates": false,
      "minimum_collapsed_lines": 3
    },
    "published_profile_argument": false
  }
}

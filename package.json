{
  "name": "distill",
  "private": true,
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:native",
    "build:native": "cargo build --locked --release --manifest-path native/distill-core/Cargo.toml",
    "check:native": "./scripts/check-native.sh",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "knip": "knip --reporter compact",
    "package:native": "./scripts/package-native.sh"
  },
  "devDependencies": {
    "knip": "^6.16.1",
    "prettier": "^3.8.4"
  },
  "engines": {
    "node": ">=20"
  }
}
